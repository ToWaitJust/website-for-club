[project]
sub_id = "b968b883"
name = "infinite-productivity"
entrypoint = "index.html"
requires = [ "nodejs-24" ]
project_type = "web"
template = "native-static"
version = "0.0.35"
appliedPatches = [ ]

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "scripts/build.sh"]
run = ["bash", "scripts/run.sh"]

[deploy.profile]
kind = "service"
flavor = "web"

[deploy]
build = ["bash", "scripts/deploy_build.sh"]
run = ["bash", "scripts/deploy_run.sh"]

[subprojects]
path = ["."]
