---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { businessLines } from '../../../data/site';
import { getBusinessContents } from '../../../lib/business';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

export async function getStaticPaths() {
  const contents = getBusinessContents();
  return contents.map((content) => ({
    params: { slug: content.slug },
    props: { content },
  }));
}

const { content } = Astro.props;
const line = businessLines.find((l) => l.slug === content.slug)!;
const processor = await createMarkdownProcessor();
const { code: html } = await processor.render(content.markdown);
---

<BaseLayout
  title={`${line.name} · AI+CLUB`}
  description={line.desc}
>
  <!-- 业务线头部 -->
  <section
    class="relative overflow-hidden pt-32 pb-10 text-center"
    style="background: radial-gradient(ellipse 90% 70% at 50% -30%, #16244d 0%, #0d1526 55%, #0a0f1e 100%)"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 opacity-30"
      style="background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 80% 70% at 50% 20%, black 30%, transparent 75%);"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-0 h-64 w-[36rem] -translate-x-1/2 rounded-full blur-[110px]"
      style={`background: radial-gradient(ellipse, ${line.accent}33 0%, transparent 70%)`}
    ></div>

    <div class="relative container-site">
      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl text-3xl"
        style={`background: ${line.accent}26; box-shadow: 0 0 36px ${line.accent}40`}
      >
        {line.icon}
      </div>
      <h1 class="font-display text-5xl font-bold tracking-tight text-white">
        {line.name}
      </h1>
      <p class="mt-2 font-display text-lg text-slate-400">{line.tagline}</p>
    </div>
  </section>

  <!-- 正文 + CTA -->
  <section class="container-site -mt-6 pb-8">
    <article class="glass-card mx-auto max-w-3xl rounded-xl px-7 py-8 sm:px-10">
      <div class="md-prose" set:html={html} />

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4 border-t border-white/10 pt-8">
        <a
          href={`/business/${line.slug}/register/`}
          class="rounded-full bg-gradient-to-r from-accent to-accent-soft px-9 py-3 font-display text-sm font-semibold text-white transition hover:opacity-90 active:scale-95"
        >
          Apply Now →
        </a>
        {
          line.slug === 'ai-it' && (
            <a
              href="/docs/learning-plan.html"
              class="rounded-full border border-white/15 bg-white/5 px-9 py-3 font-display text-sm font-medium text-white transition hover:bg-white/10"
            >
              Learning Plan
            </a>
          )
        }
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .md-prose :global(h1) {
    @apply font-display text-2xl font-semibold text-white;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .md-prose :global(h2) {
    @apply font-display text-xl font-semibold text-white;
    margin: 1.8rem 0 0.8rem;
  }
  .md-prose :global(h3) {
    @apply text-lg font-semibold text-white;
    margin: 1.4rem 0 0.6rem;
  }
  .md-prose :global(p) {
    @apply mb-3 text-[15px] leading-relaxed text-slate-300;
  }
  .md-prose :global(ul),
  .md-prose :global(ol) {
    @apply mb-3 ml-5 text-[15px] text-slate-300;
  }
  .md-prose :global(li) {
    margin-bottom: 0.3rem;
  }
  .md-prose :global(strong) {
    @apply font-semibold text-white;
  }
  .md-prose :global(blockquote) {
    @apply my-4 rounded-r-lg border-l-[3px] border-accent bg-white/5 px-4 py-3 text-sm text-slate-400;
  }
  .md-prose :global(table) {
    @apply my-4 w-full border-collapse text-sm;
  }
  .md-prose :global(th) {
    @apply border border-white/10 bg-white/5 px-3 py-2 text-left font-semibold text-white;
  }
  .md-prose :global(td) {
    @apply border border-white/10 px-3 py-2 text-slate-300;
  }
  .md-prose :global(a) {
    @apply text-accent no-underline hover:underline;
  }
</style>
