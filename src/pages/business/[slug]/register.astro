---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RegisterForm from '../../../components/RegisterForm.vue';
import { businessLines, site } from '../../../data/site';
import { getBusinessContents } from '../../../lib/business';

export async function getStaticPaths() {
  const contents = getBusinessContents();
  return contents.map((content) => ({
    params: { slug: content.slug },
    props: { content },
  }));
}

const { content } = Astro.props;
const line = businessLines.find((l) => l.slug === content.slug)!;
---

<BaseLayout
  title={`Register · ${line.name} · AI+CLUB`}
  description={`${line.name} 业务线报名`}
>
  <section
    class="below-nav relative overflow-hidden text-center"
    style="padding-bottom: var(--sp-12); background: var(--head-grad)"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 rounded-full"
      style={`width: min(90vw, 32rem); height: var(--orb-sm); filter: blur(clamp(60px, 13vw, 100px)); background: radial-gradient(ellipse, color-mix(in srgb, ${line.accent} 19%, transparent) 0%, transparent 70%)`}
    ></div>
    <div class="relative container-site">
      <p
        class="font-display uppercase text-muted"
        style="font-size: var(--fs-eyebrow); letter-spacing: clamp(0.18em, 0.9vw, 0.35em)"
      >
        Join {line.name}
      </p>
      <h1
        class="font-display font-bold tracking-tight text-ink [text-wrap:balance]"
        style="font-size: var(--fs-d2); margin-top: var(--sp-2); overflow-wrap: break-word"
      >
        {line.name} · Register
      </h1>
      <p class="text-muted" style="font-size: var(--fs-sm); margin-top: var(--sp-3)">
        {line.tagline}
      </p>
    </div>
  </section>

  <section
    class="container-site"
    style="margin-top: calc(-1 * var(--sp-6)); padding-bottom: var(--sp-6)"
  >
    <RegisterForm
      client:load
      businessLine={line.slug}
      businessName={line.name}
      apiBase={site.apiBase}
      open={line.registerOpen}
    />
  </section>
</BaseLayout>
