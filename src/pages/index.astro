---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import BizCard from '../components/BizCard.astro';
import NoticeList from '../components/NoticeList.astro';
import { businessLines, notices } from '../data/site';
---

<BaseLayout
  title="AI+CLUB · 福州大学"
  description="AI+CLUB 集成门户 - AI+IT / AI+业务 / AI+嵌入式 三条业务线信息展示、报名与反馈"
>
  <Hero />

  <!-- 业务线:负上边距用 --sp-* 流式,窄屏不会与 Hero 重叠过多 -->
  <section
    class="container-site relative"
    style="margin-top: calc(-1 * var(--sp-10)); padding-bottom: var(--sp-6)"
  >
    <!-- 区域光晕:让卡片毛玻璃有内容可模糊 -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 mx-auto rounded-full opacity-60"
      style="top: calc(-1 * var(--sp-12)); height: var(--orb-sm); max-width: 42rem; filter: blur(clamp(70px, 15vw, 120px)); background: radial-gradient(ellipse, rgba(59,130,246,.16) 0%, transparent 70%)"
    >
    </div>

    <div class="relative">
      <div class="text-center" style="margin-bottom: var(--sp-6)">
        <h2
          class="font-display uppercase text-slate-400"
          style="font-size: var(--fs-eyebrow); letter-spacing: clamp(0.16em, 0.8vw, 0.3em)"
        >
          Our Tracks
        </h2>
        <p
          class="font-semibold text-white"
          style="font-size: var(--fs-h2); margin-top: var(--sp-1)"
        >
          AI+Everything
        </p>
      </div>

      <!-- 单列 → md 三列;gap 流式(加大间距,保证三卡清晰隔开) -->
      <div class="grid gap-f12 md:grid-cols-3">
        {
          businessLines.map((line, i) => (
            <div class="animate-fade-up" style={`animation-delay: ${i * 100}ms`}>
              <BizCard line={line} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 公告 -->
  <section class="container-site" style="margin-top: var(--sp-16)">
    <h2
      class="font-display uppercase text-slate-400"
      style="font-size: var(--fs-h3); letter-spacing: clamp(0.12em, 0.6vw, 0.22em); margin-bottom: var(--sp-4)"
    >
      Announcements
    </h2>
    <div class="ml-auto max-w-[var(--content-max)]">
      <NoticeList notices={notices} />
    </div>
  </section>
</BaseLayout>
