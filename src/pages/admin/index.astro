---
import '../../styles/global.css';
import AdminPanel from '../../components/admin/AdminPanel.vue';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>Admin Console · AI+CLUB</title>
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/space-grotesk@5/index.min.css"
    />
    <!-- 首绘前应用主题(防闪烁),key 与全站共享 -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var t = localStorage.getItem('wb-theme');
          if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t);
          else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches)
            root.setAttribute('data-theme', 'light');
        } catch (e) {
          root.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-bg">
    <!-- 主题切换:浮动右上角 -->
    <button
      id="theme-toggle"
      type="button"
      aria-label="切换深色/浅色主题"
      class="tap-target fixed right-4 top-4 z-50 flex items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:bg-surface hover:text-ink"
      style="width: var(--tap); height: var(--tap)"
    >
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </button>
    <!-- 背景光斑:尺寸随屏等比,定位用百分比 -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 overflow-hidden">
      <div
        class="absolute rounded-full bg-accent/20"
        style="width: var(--orb-lg); height: var(--orb-lg); left: 25%; top: 0; transform: translate(-50%, -45%); filter: blur(clamp(70px, 15vw, 120px))"
      >
      </div>
      <div
        class="absolute rounded-full bg-accent-soft/15"
        style="width: var(--orb-md); height: var(--orb-md); right: 25%; bottom: 0; transform: translate(50%, 45%); filter: blur(clamp(70px, 15vw, 120px))"
      >
      </div>
    </div>

    <main
      class="relative z-10 mx-auto w-full max-w-5xl"
      style="padding: var(--sp-10) var(--container-px) calc(var(--sp-10) + var(--safe-b))"
    >
      <AdminPanel client:load />
    </main>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var root = document.documentElement;
          var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('wb-theme', next);
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
