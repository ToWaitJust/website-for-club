---
import type { Notice } from '../data/site';

interface Props {
  notices: Notice[];
}

const { notices } = Astro.props;
---

<div class="glass-card rounded-xl" style="padding: var(--sp-6)">
  {
    notices.length ? (
      <ul class="divide-y divide-line">
        {notices.map((n) => (
          <li style="padding-top: var(--sp-3); padding-bottom: var(--sp-3)">
            {/* 窄屏改为纵向排列,标题与日期不再互相挤压 */}
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-f4">
              <h3
                class="min-w-0 font-display font-semibold tracking-wide"
                style="font-size: var(--fs-h3)"
              >
                {n.title}
              </h3>
              <time
                class="shrink-0 text-muted"
                style="font-size: var(--fs-xs)"
              >
                {n.date}
              </time>
            </div>
            {n.content && (
              <p
                class="text-ink-soft"
                style="font-size: var(--fs-sm); margin-top: var(--sp-1)"
              >
                {n.content}
              </p>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-muted" style="font-size: var(--fs-sm)">
        No announcements
      </p>
    )
  }
</div>
