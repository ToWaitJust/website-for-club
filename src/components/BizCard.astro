---
import type { BusinessLine } from '../data/site';

interface Props {
  line: BusinessLine;
}

const { line } = Astro.props;
---

<a
  href={line.path}
  class="glass-card group relative block h-full rounded-xl transition-all duration-300 hover:-translate-y-1.5 hover:shadow-card-hover"
  style={`--card-accent: ${line.accent}; padding: var(--sp-6)`}
>
  <!-- 顶部品牌色光条:hover 增亮 -->
  <span
    class="absolute inset-x-0 top-0 h-[2px] rounded-t-xl transition-all duration-300 group-hover:h-[3px] group-hover:opacity-90"
    style={`background: linear-gradient(90deg, transparent, ${line.accent}, transparent)`}
  ></span>

  <!-- hover 品牌色光晕:尺寸随屏等比 -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 -translate-x-1/2 rounded-full opacity-0 transition-opacity duration-500 group-hover:opacity-40"
    style={`top: calc(-1 * var(--sp-10)); width: clamp(120px, 28vw, 160px); height: clamp(96px, 22vw, 128px); filter: blur(60px); background: ${line.accent}`}
  ></span>

  <!-- 报名状态徽章:定位用流式间距,窄屏不会压住标题 -->
  <span
    class={`absolute rounded-full font-display font-semibold uppercase tracking-wider ${
      line.registerOpen
        ? 'border border-ai-embed/30 bg-ai-embed/10 text-ai-embed'
        : 'border border-line bg-surface text-muted'
    }`}
    style="right: var(--sp-5); top: var(--sp-5); padding: 2px var(--sp-2); font-size: var(--fs-xs)"
  >
    {line.registerOpen ? 'Open' : 'Soon'}
  </span>

  <!-- 图标:rpx 等比(设计稿 96rpx),hover 放大轻旋 -->
  <div
    class="flex items-center justify-center rounded-lg transition-transform duration-300 group-hover:-rotate-3 group-hover:scale-110"
    style={`width: min(calc(96 * var(--rpx)), 84px); height: min(calc(96 * var(--rpx)), 84px); min-width: 42px; min-height: 42px; margin-bottom: var(--sp-4); font-size: var(--fs-h2); background: color-mix(in srgb, ${line.accent} 15%, transparent); box-shadow: 0 0 24px color-mix(in srgb, ${line.accent} 20%, transparent)`}
  >
    {line.icon}
  </div>

  <!-- pr 给徽章留位,防长标题与徽章重叠 -->
  <h3
    class="font-display font-semibold tracking-wide"
    style="font-size: var(--fs-h3); padding-right: calc(var(--sp-12))"
  >
    {line.name}
  </h3>
  <p
    class="font-display text-muted"
    style="font-size: var(--fs-sm); margin-top: 2px"
  >
    {line.tagline}
  </p>
  <p
    class="leading-relaxed text-ink-soft"
    style="font-size: var(--fs-sm); margin-top: var(--sp-2)"
  >
    {line.desc}
  </p>

  <div class="flex flex-wrap gap-1.5" style="margin-top: var(--sp-4)">
    {
      line.features.map((f) => (
        <span
          class="rounded-full border border-line bg-surface text-ink-soft"
          style="padding: 2px var(--sp-2); font-size: var(--fs-xs)"
        >
          {f}
        </span>
      ))
    }
  </div>

  <div
    class="flex items-center gap-1 font-display font-medium transition-transform duration-300 group-hover:translate-x-1.5"
    style={`margin-top: var(--sp-5); font-size: var(--fs-sm); color: ${line.accent}`}
  >
    Explore <span aria-hidden="true">→</span>
  </div>
</a>
