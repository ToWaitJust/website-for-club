---
import { site } from '../data/site';

const pathname = Astro.url.pathname;
const isActive = (match: string) => new RegExp(match).test(pathname);
---

<!-- 固定导航:高度流式(--nav-h),顶部预留刘海安全区 -->
<header
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bg/70 backdrop-blur-xl"
  style="padding-top: var(--safe-t)"
>
  <div class="container-site flex h-nav items-center gap-f3">
    <!-- 品牌:shrink-0 防被导航挤压变形 -->
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 font-semibold no-underline text-ink"
    >
      <span
        class="flex shrink-0 items-center justify-center font-bold text-gradient-brand"
        style="width: min(calc(56 * var(--rpx)), 48px); height: min(calc(56 * var(--rpx)), 48px); min-width: 26px; min-height: 26px; font-size: var(--fs-h2)"
      >♾</span>
      <span class="hidden font-display tracking-wide xs:inline" style="font-size: var(--fs-sm)"
        >{site.brand}</span
      >
    </a>

    <!-- 导航:窄屏横向可滚动(隐藏滚动条),任何宽度都不会溢出或换行 -->
    <nav aria-label="主导航" class="no-scrollbar -mx-1 ml-auto overflow-x-auto">
      <ul class="flex items-center gap-0.5 px-1">
        {
          site.nav.map((item) => {
            const active = isActive(item.match);
            return (
              <li class="shrink-0">
                <a
                  href={item.href}
                  class={`flex items-center whitespace-nowrap rounded-lg no-underline transition-colors ${
                    active
                      ? 'bg-surface-strong font-semibold text-ink'
                      : 'text-ink-soft hover:bg-surface hover:text-ink'
                  }`}
                  style="padding: var(--sp-2) var(--sp-3); font-size: var(--fs-sm)"
                >
                  {item.label}
                  {item.external && <span class="ml-0.5 opacity-60" style="font-size: var(--fs-xs)">↗</span>}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- 主题切换:深色显示太阳,浅色显示月亮 -->
    <button
      id="theme-toggle"
      type="button"
      aria-label="切换深色/浅色主题"
      class="tap-target flex shrink-0 items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:bg-surface hover:text-ink"
      style="width: var(--tap); height: var(--tap)"
    >
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var root = document.documentElement;
      var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('wb-theme', next);
      } catch (e) {
        /* 隐私模式忽略 */
      }
    });
  })();
</script>
