er from 'bpmn-js/lib/Modeler';\n\nimport camundaExtensionModule from 'camunda-bpmn-moddle/lib';\nimport camundaModdle from 'camunda-bpmn-moddle/resources/camunda.json';\n\nvar modeler = new BpmnModeler({\n  additionalModules: [\n    camundaExtensionModule\n  ],\n  moddleExtensions: {\n    camunda: camundaModdle\n  }\n});\n```\n\nThis extension hooks into the copy mechanism provided by the BPMN editor and ensures Camunda properties are kept and or dropped on copy and element replace.\n\n\n## License\n\nUse under the terms of the [MIT license](http://opensource.org/licenses/MIT).\n","gitHead":"b69d414a64b2d07214075b2043320c8943154a17","scripts":{"all":"run-s lint test","dev":"npm run test:browser -- --auto-watch --no-single-run","lint":"eslint .","test":"run-s test:*","test:node":"mocha -r ./test/expect --reporter=spec \"test/!(browser)/**/*.js\"","test:browser":"karma start karma.config.js"},"_npmUser":{"name":"nikku","email":"git_nikku@nixis.de"},"repository":{"url":"git+https://github.com/camunda/camunda-bpmn-moddle.git","type":"git"},"_npmVersion":"6.14.15","description":"Camunda moddle extensions for BPMN 2.0","directories":{},"_nodeVersion":"14.18.1","dependencies":{"min-dash":"^3.8.1","inherits-browser":"0.0.1"},"_hasShrinkwrap":false,"readmeFilename":"README.md","devDependencies":{"esm":"^3.2.25","chai":"^4.3.0","glob":"^7.1.6","karma":"^6.3.16","mocha":"^8.2.1","sinon":"^9.2.4","eslint":"^7.19.0","bpmn-js":"^9.3.2","webpack":"^5.26.3","p-series":"^2.1.0","puppeteer":"^8.0.0","raw-loader":"^4.0.2","sinon-chai":"^3.5.0","bpmn-moddle":"^7.0.4","karma-mocha":"^2.0.1","npm-run-all":"^4.1.2","karma-webpack":"^5.0.0","karma-sinon-chai":"^2.0.2","xsd-schema-validator":"^0.5.0","eslint-plugin-bpmn-io":"^0.12.0","karma-chrome-launcher":"^3.1.0","karma-env-preprocessor":"^0.1.1","mocha-test-container-support":"^0.2.0"},"peerDependencies":{"bpmn-js":"^6.x || ^7.x || ^8.x || ^9.x","diagram-js":"^5.x || ^6.x || ^7.x || ^8.x"},"_npmOperationalInternal":{"tmp":"tmp/camunda-b