# ===== 数据库/Redis 连接配置模板 =====
# 复制本文件为 .env,填入真实值后使用 scripts/start-server.ps1 启动后端。
# 本文件可提交;.env 已被 .gitignore 忽略,切勿把真实密钥写进任何会提交的文件。

# MySQL 主库连接
MYSQL_URL=jdbc:mysql://HOST:PORT/DATABASE?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true
MYSQL_USERNAME=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# Redis 连接
REDIS_HOST=HOST
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=